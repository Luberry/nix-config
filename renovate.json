{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/Chicago",
  "enabledManagers": ["custom.regex", "nix"],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "description": "Weekly `nix flake update`; mostly security/bug fixes since nixpkgs tracks a stable channel",
    "enabled": true,
    "schedule": ["before 6am on friday"]
  },
  "customManagers": [
    {
      "description": "Pinned OCI container images in NixOS modules",
      "customType": "regex",
      "managerFilePatterns": ["/^hosts/.+\\.nix$/"],
      "matchStrings": ["image = \"(?<depName>[^\":]+):(?<currentValue>[^\"]+)\";"],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "openHAB: stable 5.x releases only (no milestones, RCs or snapshots)",
      "matchDepNames": ["openhab/openhab"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "allowedVersions": "/^5\\./"
    },
    {
      "description": "delugevpn: binhex's <version>-<build>-<revision> tags, without the libtorrentv1 variant",
      "matchDepNames": ["binhex/arch-delugevpn"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)-(?<revision>\\d+)$"
    }
  ]
}
